{
  "name": "stoa-dev-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @stoa-dev/kit",
    "dev": "npm run dev --workspace @stoa-dev/kit",
    "typecheck": "npm run typecheck --workspace @stoa-dev/kit",
    "lint": "biome lint .",
    "biome": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run build && npm run storybook:test",
    "rust:test": "cargo test --manifest-path crates/stoa-licensing/Cargo.toml",
    "release:check": "npm run check && npm pack --dry-run --workspace @stoa-dev/kit",
    "storybook": "npm run storybook --workspace @stoa-dev/storybook",
    "storybook:test": "npm run test --workspace @stoa-dev/storybook"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "vitest": "^4.1.12",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/ui": "^4.1.12"
  }
}
